@model IT_ELECTIVE_FINAL_EXAM_BSIT_31A1.Models.ClassmateProfile
@{
    ViewData["Title"] = Model.FullName;
}

<a asp-controller="Home" asp-action="Index" class="text-decoration-none">&larr; Back to class list</a>

<!-- PERSONAL INFORMATION -->
<section class="card shadow-sm my-3">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-3 text-center mb-3 mb-md-0">
                <img src="@Url.Content(Model.PhotoPath)" alt="@Model.FullName"
                     class="rounded-circle img-fluid" style="width:160px;height:160px;object-fit:cover;" />
            </div>
            <div class="col-md-9">
                <h2 class="mb-0">@Model.FullName</h2>
                <p class="text-primary fw-semibold">@Model.Tagline</p>
                <p class="mb-1 text-muted">@Model.Course @(string.IsNullOrWhiteSpace(Model.Section) ? "" : "– " + Model.Section)</p>
                <p>@Model.Bio</p>

                <a class="btn btn-dark btn-sm" href="@Model.GitHubUrl" target="_blank" rel="noopener">GitHub</a>
                @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                {
                    <a class="btn btn-primary btn-sm" href="@Model.LinkedInUrl" target="_blank" rel="noopener">LinkedIn</a>
                }
                <a class="btn btn-outline-secondary btn-sm" href="mailto:@Model.Email">Email</a>
            </div>
        </div>

        @if (Model.Skills.Any())
        {
            <hr />
            <h6>Skills</h6>
            @foreach (var s in Model.Skills)
            {
                <span class="badge bg-secondary me-1">@s</span>
            }
        }
    </div>
</section>

<!-- PROJECTS (Prelim → Final) -->
<section class="my-4">
    <h3 class="mb-3">Projects</h3>
    <div class="row">
        @foreach (var p in Model.Projects.OrderBy(x => x.Stage))
        {
            <div class="col-md-6 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-info text-dark mb-2">@p.Stage</span>
                        <h5 class="card-title">@p.Title</h5>
                        <p class="card-text">@p.Description</p>
                        @foreach (var t in p.TechStack)
                        {
                            <span class="badge bg-light text-dark border me-1">@t</span>
                        }
                    </div>
                    <div class="card-footer bg-white border-0">
                        <a class="btn btn-sm btn-outline-dark" href="@p.RepoUrl" target="_blank" rel="noopener">View Repository</a>
                        @if (!string.IsNullOrWhiteSpace(p.LiveUrl))
                        {
                            <a class="btn btn-sm btn-success" href="@p.LiveUrl" target="_blank" rel="noopener">Live Demo</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>